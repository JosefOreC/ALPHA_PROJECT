[run]
branch = True
relative_files = True
source =
    src/backend
    scripts
    src/frontend/scripts
omit =
    src/backend/tests/*
    scripts/green_it_fixture.py
    scripts/measure_api_http.py

[report]
fail_under = 90
precision = 2

[xml]
output = reports/coverage/backend.xml

[json]
output = reports/coverage/backend.json
