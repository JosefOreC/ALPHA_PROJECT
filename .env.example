# Base local de pruebas. El script lee este archivo desde la raíz del proyecto.
DB_ENV=test
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/ecologistica_test
# Base de mantenimiento para CREATE DATABASE; usuario con permiso CREATEDB.
DATABASE_ADMIN_DB=postgres
DB_CREATE_IF_MISSING=true

# Todas las fechas y ventanas usan America/Lima. Datos exclusivos de prueba.
SEED_DATE=2026-10-09
SEED_DAYS=7
SEED_ORDERS_PER_DAY=150
SEED_PASSWORD=SoloPruebas_Cambiar_2026!

# Sesiones de la API. En HTTPS establecer SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SECURE=false
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Solo para crear el primer administrador con scripts/create_admin.py --from-env.
ADMIN_INITIAL_EMAIL=admin@admin.com
ADMIN_INITIAL_PASSWORD=admin123
ADMIN_INITIAL_NAME=admin
