{
  "ci": {
    "collect": {
      "staticDistDir": "./src/frontend/dist",
      "isSinglePageApplication": true,
      "url": ["http://localhost/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:seo": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./reports/lighthouse",
      "reportFilenamePattern": "lhci-%%DATETIME%%-report.%%EXTENSION%%"
    }
  }
}
